server:
  http_listen_port: 9080
  grpc_listen_port: 0
  log_level: info

positions:
  filename: /data/positions.yaml

clients:
  - url: "{{ loki_ingest_url }}"
    batchwait: 1s
    batchsize: 1048576
    backoff_config:
      min_period: 500ms
      max_period: 5m
      max_retries: 10
    timeout: 10s
    external_labels:
      node: "{{ current_host }}"

scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        regex: '/promtail'
        action: drop
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: container
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: logstream
      - source_labels: ['__meta_docker_container_label_com_docker_compose_service']
        target_label: service
      - source_labels: ['__meta_docker_container_label_loki_drop']
        regex: 'true'
        action: drop
    pipeline_stages:
      - drop:
          longer_than: 8KB
      - drop:
          expression: '^\s*$'

  - job_name: traefik-files
    static_configs:
      - targets: [localhost]
        labels:
          job: traefik
          node: "{{ current_host }}"
          __path__: /srv/traefik-logs/*.log
    pipeline_stages:
      - drop:
          expression: '^\s*$'
      - drop:
          longer_than: 8KB

  - job_name: syslog-files
    static_configs:
      - targets: [localhost]
        labels:
          job: varlog
          node: "{{ current_host }}"
          __path__: /var/log/{syslog,auth.log,kern.log,dpkg.log,unattended-upgrades/unattended-upgrades*.log}
    pipeline_stages:
      - drop:
          expression: '^\s*$'
      - drop:
          longer_than: 8KB
