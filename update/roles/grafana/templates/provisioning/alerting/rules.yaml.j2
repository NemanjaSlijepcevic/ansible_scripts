                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "disk" and r._field == "used_percent")
                  |> last()
                  |> map(fn: (r) => ({r with node: "{{ b }}"}))
                  |> keep(columns: ["_time", "node", "path", "_value"])
                {% endfor %}
                {% if telegraf_buckets|length > 1 %}]){% endif %}
