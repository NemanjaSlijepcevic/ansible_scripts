                from(bucket: "telegraf-postgres")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "postgresql" and r._field == "numbackends")
                  |> last()
                  |> group()
                  |> sum()
                  |> keep(columns: ["_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
