        isPaused: false
        annotations:
          summary: "{% raw %}pfSense memory used {{ printf \"%.1f\" $values.B.Value }}%{% endraw %}"
          description: "{% raw %}pfSense memory above {% endraw %}{{ alerts.pfsense_mem_warn }}% for {{ alerts.pfsense_for }}"
        labels:
          severity: warning
          category: pfsense
        data:
          - refId: A
            datasourceUid: influxdb-pfsense
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb-pfsense }
              query: |
                from(bucket: "pfsense")
                  |> range(start: -10m)
                  |> filter(fn: (r) => r._measurement == "mem" and r._field == "used_percent")
                  |> mean()
                  |> keep(columns: ["_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.pfsense_mem_warn }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-pfsense-wan-down
        title: pfSense WAN no traffic
        condition: C
        noDataState: Alerting
        execErrState: Error
        for: "{{ alerts.wan_down_for }}"
        isPaused: false
        annotations:
          summary: "pfSense WAN ({{ alerts.wan_interface }}) no RX bytes for {{ alerts.wan_down_for }}"
          description: "No incoming traffic on WAN interface — link may be down"
        labels:
          severity: critical
          category: pfsense
        data:
          - refId: A
            datasourceUid: influxdb-pfsense
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb-pfsense }
              query: |
                from(bucket: "pfsense")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "net" and r._field == "bytes_recv" and r.interface == "{{ alerts.wan_interface }}")
                  |> derivative(unit: 1s, nonNegative: true)
                  |> mean()
                  |> keep(columns: ["_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-pfsense-pf-states
        title: pfSense PF state table near limit
        condition: C
        noDataState: OK
        execErrState: Error
        for: "5m"
        isPaused: false
        annotations:
          summary: "{% raw %}PF states at {{ printf \"%.1f\" $values.B.Value }}% of limit{% endraw %}"
          description: "PF state table usage above {{ alerts.pf_states_pct }}% of configured limit"
        labels:
          severity: warning
          category: pfsense
        data:
          - refId: A
            datasourceUid: influxdb-pfsense
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb-pfsense }
              query: |
                from(bucket: "pfsense")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "pf" and (r._field == "entries" or r._field == "state-limit"))
                  |> last()
                  |> pivot(rowKey: ["host"], columnKey: ["_field"], valueColumn: "_value")
                  |> filter(fn: (r) => exists r["state-limit"] and r["state-limit"] > 0)
                  |> map(fn: (r) => ({_value: 100.0 * float(v: r.entries) / float(v: r["state-limit"])}))
                  |> keep(columns: ["_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.pf_states_pct }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

  - orgId: 1
