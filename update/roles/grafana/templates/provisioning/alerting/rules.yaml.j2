apiVersion: 1

# Rules removed from the template must be listed here too — file
# provisioning never deletes an already-provisioned rule on its own.
deleteRules:
  # immich host not deployed yet (commented out in defaults)
  - orgId: 1
    uid: hl-node-gap-immich
  - orgId: 1
    uid: hl-log-gap-immich
  # traefik-automation hidden (see traefik_alert_hosts in grafana defaults) —
  # remove these two when the host is re-enabled.
  - orgId: 1
    uid: hl-traefik-5xx-automation
  - orgId: 1
    uid: hl-traefik-p95-automation
  # pfSense node_exporter has no pf state-table metric — rule dropped.
  - orgId: 1
    uid: hl-pfsense-pf-states

groups:
  - orgId: 1
    name: homelab-http-uptime
    folder: Homelab
    interval: 60s
    rules:

      - uid: hl-http-service-down
        title: HTTP Service Down
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.http_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {{ $labels.host }} is DOWN ({{ $labels.via }}){% endraw %}"
          description: "{% raw %}Blackbox probe_success=0 for service {{ $labels.service }} (host={{ $labels.host }}, via={{ $labels.via }}).{% endraw %}"
        labels:
          severity: critical
          category: http-uptime
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 300, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: min by (service, host, via) (probe_success)
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-http-slow-warn
        title: HTTP Slow Response (warn)
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.rt_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {{ $labels.host }} slow ({{ humanizeDuration $values.B.Value }}){% endraw %}"
          description: "{% raw %}Mean probe_duration_seconds over 5m exceeds {% endraw %}{{ alerts.rt_warn }}s"
        labels:
          severity: warning
          category: http-uptime
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: max by (service, host) (avg_over_time(probe_duration_seconds{via="internal"}[5m]))
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.rt_warn }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-http-slow-crit
        title: HTTP Slow Response (critical)
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.rt_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {{ $labels.host }} CRITICAL slow ({{ humanizeDuration $values.B.Value }}){% endraw %}"
          description: "{% raw %}Mean probe_duration_seconds over 5m exceeds {% endraw %}{{ alerts.rt_crit }}s"
        labels:
          severity: critical
          category: http-uptime
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: max by (service, host) (avg_over_time(probe_duration_seconds{via="internal"}[5m]))
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.rt_crit }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

{% for h in monitored_hosts %}
      - uid: hl-node-gap-{{ h }}
        title: "Node metrics gap ({{ h }})"
        condition: C
        noDataState: Alerting
        execErrState: Error
        for: "{{ alerts.node_gap_for }}"
        isPaused: false
        annotations:
          summary: "Node {{ h }} has no metrics"
          description: "No node_exporter samples in last 5m from host {{ h }}. Host or Alloy agent likely down."
        labels:
          severity: critical
          category: node-health
          node: "{{ h }}"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: count_over_time(node_time_seconds{host="{{ h }}"}[5m])
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query
{% endfor %}

