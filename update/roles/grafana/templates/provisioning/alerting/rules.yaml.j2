          description: "{% raw %}Traefik service p95 request duration exceeds threshold on {% endraw %}{{ tb }}"
        labels:
          severity: warning
          category: traefik
          bucket: "{{ tb }}"
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                from(bucket: "{{ tb }}")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "traefik.service.request.duration" and r._field == "p95")
                  |> group(columns: ["service"])
                  |> mean()
                  |> keep(columns: ["service", "_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
