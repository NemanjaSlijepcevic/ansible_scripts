  - orgId: 1
    name: homelab-certs
    folder: Homelab
    interval: 300s
    rules:

      # TLS cert expiry from the blackbox HTTPS probes (probe_ssl_earliest_cert_expiry
      # is a future unix ts; internal http probes don't emit it → the > 0 guard).
      - uid: hl-cert-expiry-warn
        title: TLS certificate expiring (warn)
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.cert_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} cert on {{ $labels.host }} expires in {{ printf \"%.0f\" $values.B.Value }}d{% endraw %}"
          description: "{% raw %}TLS certificate expires in under {% endraw %}{{ alerts.cert_warn_days }} days — renewal (Traefik/Cloudflare DNS) may be stuck."
        labels:
          severity: warning
          category: certs
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: min by (service, host) (((probe_ssl_earliest_cert_expiry - time()) / 86400) and (probe_ssl_earliest_cert_expiry > 0))
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [{{ alerts.cert_warn_days }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-cert-expiry-crit
        title: TLS certificate expiring (critical)
        condition: C
        noDataState: OK
