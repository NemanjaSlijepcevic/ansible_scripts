  - orgId: 1
    name: homelab-containers
    folder: Homelab
    interval: 60s
    rules:

      # Long-lived services run with restart_policy unless-stopped, so a
      # container persisting in "exited" means stopped by hand or Docker
      # gave up. Ephemeral task containers (kestra runners) are removed
      # seconds after exit and stay below the sample-count threshold.
      - uid: hl-ct-exited
        title: Container stopped
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.container_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}Container {{ $labels.container_name }} on {{ $labels.node }} is not running{% endraw %}"
          description: "Container has been in state 'exited' for more than ~2 minutes."
        labels:
          severity: critical
          category: containers
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                {% if telegraf_buckets|length > 1 %}union(tables: [{% endif %}
                {% for b in telegraf_buckets %}{% if loop.index > 1 %},{% endif %}
                from(bucket: "{{ b }}")
                  |> range(start: -10m)
                  |> filter(fn: (r) => r._measurement == "docker_container_status" and r._field == "exitcode" and r.container_status == "exited")
                  |> map(fn: (r) => ({r with node: "{{ b | replace('telegraf-', '') }}"}))
                  |> keep(columns: ["_time", "container_name", "node", "_value"])
                {% endfor %}
                {% if telegraf_buckets|length > 1 %}]){% endif %}
                  |> group(columns: ["container_name", "node"])
                  |> count()
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.container_exited_min }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-ct-oom
        title: Container OOM killed
        condition: C
        noDataState: OK
        execErrState: Error
        for: "0s"
        isPaused: false
        annotations:
          summary: "{% raw %}Container {{ $labels.container_name }} on {{ $labels.node }} was OOM-killed{% endraw %}"
          description: "Docker reported oomkilled=true — raise the container's memory limit or find the leak."
        labels:
          severity: critical
          category: containers
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                {% if telegraf_buckets|length > 1 %}union(tables: [{% endif %}
                {% for b in telegraf_buckets %}{% if loop.index > 1 %},{% endif %}
                from(bucket: "{{ b }}")
                  |> range(start: -10m)
                  |> filter(fn: (r) => r._measurement == "docker_container_status" and r._field == "oomkilled" and r._value == true)
                  |> map(fn: (r) => ({r with node: "{{ b | replace('telegraf-', '') }}", _value: 1}))
                  |> keep(columns: ["_time", "container_name", "node", "_value"])
                {% endfor %}
                {% if telegraf_buckets|length > 1 %}]){% endif %}
                  |> group(columns: ["container_name", "node"])
                  |> count()
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [0] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

  - orgId: 1
    name: homelab-logs
    folder: Homelab
    interval: 60s
    rules:

{% for b in telegraf_buckets %}
{% set node = b | replace('telegraf-', '') %}
      # Container-state and node-gap rules can't see a promtail that is
      # running but not shipping; absence of ANY log line for a node in
      # 15m means the log pipeline (promtail → loki) is broken.
      - uid: hl-log-gap-{{ node }}
        title: "Log ingest gap ({{ node }})"
        condition: C
        noDataState: Alerting
        execErrState: Error
        for: "{{ alerts.log_gap_for }}"
        isPaused: false
        annotations:
          summary: "No logs from {{ node }} reaching Loki"
          description: "Zero log lines with node={{ node }} in the last 15m. Promtail on {{ node }} is down or cannot reach Loki."
        labels:
          severity: critical
          category: logs
          node: "{{ node }}"
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: loki, uid: loki }
              expr: sum(count_over_time({node="{{ node }}"} [15m]))
              queryType: instant
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query
{% endfor %}
