  - orgId: 1
    name: homelab-traefik
    folder: Homelab
    interval: 60s
    rules:

{% for h in traefik_alert_hosts %}
      - uid: hl-traefik-5xx-{{ h }}
        title: "Traefik 5xx spike ({{ h }})"
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.traefik_5xx_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {% endraw %}{{ h }} 5xx >{{ alerts.traefik_5xx_rate }}/s"
          description: "{% raw %}Traefik 5xx response rate exceeds threshold on {% endraw %}{{ h }}"
        labels:
          severity: critical
          category: traefik
          host: "{{ h }}"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: sum by (service) (rate(traefik_service_requests_total{host="{{ h }}", code=~"5.."}[5m]))
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.traefik_5xx_rate }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-traefik-p95-{{ h }}
        title: "Traefik p95 latency high ({{ h }})"
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.traefik_p95_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {% endraw %}{{ h }} p95 >{{ alerts.traefik_p95_warn }}s"
          description: "{% raw %}Traefik service p95 request duration exceeds threshold on {% endraw %}{{ h }}"
        labels:
          severity: warning
          category: traefik
          host: "{{ h }}"
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: histogram_quantile(0.95, sum by (service, le) (rate(traefik_service_request_duration_seconds_bucket{host="{{ h }}"}[5m])))
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.traefik_p95_warn }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query
{% endfor %}

