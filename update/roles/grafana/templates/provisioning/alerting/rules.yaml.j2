  - orgId: 1
    name: homelab-traefik
    folder: Homelab
    interval: 60s
    rules:

{% for tb in traefik_alert_buckets %}
      - uid: hl-traefik-5xx-{{ tb }}
        title: "Traefik 5xx spike ({{ tb }})"
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.traefik_5xx_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {% endraw %}{{ tb }} 5xx >{{ alerts.traefik_5xx_rate }}/s"
          description: "{% raw %}Traefik 5xx response rate exceeds threshold on {% endraw %}{{ tb }}"
        labels:
          severity: critical
          category: traefik
          bucket: "{{ tb }}"
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                from(bucket: "{{ tb }}")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "traefik.service.requests.total" and r._field == "count" and r.code =~ /^5/)
                  |> derivative(unit: 1s, nonNegative: true)
                  |> group(columns: ["service"])
                  |> mean()
                  |> keep(columns: ["service", "_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.traefik_5xx_rate }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-traefik-p95-{{ tb }}
