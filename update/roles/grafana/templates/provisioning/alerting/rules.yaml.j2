apiVersion: 1

# Rules removed from the template must be listed here too — file
# provisioning never deletes an already-provisioned rule on its own.
deleteRules:
  # immich host not deployed yet (bucket commented out in defaults)
  - orgId: 1
    uid: hl-node-gap-telegraf-immich
  - orgId: 1
    uid: hl-log-gap-immich
  # traefik-automation hidden (see traefik_alert_buckets in grafana defaults) —
  # remove these two when the bucket is re-enabled.
  - orgId: 1
    uid: hl-traefik-5xx-traefik-automation
  - orgId: 1
    uid: hl-traefik-p95-traefik-automation

groups:
  - orgId: 1
    name: homelab-http-uptime
    folder: Homelab
    interval: 60s
    rules:

      - uid: hl-http-service-down
        title: HTTP Service Down
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.http_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {{ $labels.node }} is DOWN ({{ $labels.via }}){% endraw %}"
          description: "{% raw %}HTTP probe returned result_code={{ $values.B }} for service {{ $labels.service }} (node={{ $labels.node }}, via={{ $labels.via }}). 0=UP, 1=CONNECT, 2=TIMEOUT, 3=BODY, 4=RESP, 5=DNS.{% endraw %}"
        labels:
          severity: critical
          category: http-uptime
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 300, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                {% if telegraf_buckets|length > 1 %}union(tables: [{% endif %}
                {% for b in telegraf_buckets %}{% if loop.index > 1 %},{% endif %}
                from(bucket: "{{ b }}")
                  |> range(start: -2m)
                  |> filter(fn: (r) => r._measurement == "http_response" and r._field == "result_code")
                  |> last()
                  |> map(fn: (r) => ({r with node: "{{ b }}"}))
                  |> keep(columns: ["_time", "service", "via", "node", "_value"])
                {% endfor %}
                {% if telegraf_buckets|length > 1 %}]){% endif %}
                  |> group(columns: ["service", "node", "via"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [0.5] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-http-slow-warn
        title: HTTP Slow Response (warn)
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.rt_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {{ $labels.node }} slow ({{ humanizeDuration $values.B.Value }}){% endraw %}"
          description: "{% raw %}Mean response_time over 5m exceeds {% endraw %}{{ alerts.rt_warn }}s"
        labels:
          severity: warning
          category: http-uptime
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                {% if telegraf_buckets|length > 1 %}union(tables: [{% endif %}
                {% for b in telegraf_buckets %}{% if loop.index > 1 %},{% endif %}
                from(bucket: "{{ b }}")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "http_response" and r._field == "response_time" and r.via == "internal")
                  |> map(fn: (r) => ({r with node: "{{ b }}"}))
                {% endfor %}
                {% if telegraf_buckets|length > 1 %}]){% endif %}
                  |> group(columns: ["service", "node"])
                  |> mean()
                  |> keep(columns: ["service", "node", "_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.rt_warn }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-http-slow-crit
        title: HTTP Slow Response (critical)
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.rt_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.service }} on {{ $labels.node }} CRITICAL slow ({{ humanizeDuration $values.B.Value }}){% endraw %}"
          description: "{% raw %}Mean response_time over 5m exceeds {% endraw %}{{ alerts.rt_crit }}s"
        labels:
          severity: critical
          category: http-uptime
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                {% if telegraf_buckets|length > 1 %}union(tables: [{% endif %}
                {% for b in telegraf_buckets %}{% if loop.index > 1 %},{% endif %}
                from(bucket: "{{ b }}")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "http_response" and r._field == "response_time" and r.via == "internal")
                  |> map(fn: (r) => ({r with node: "{{ b }}"}))
                {% endfor %}
                {% if telegraf_buckets|length > 1 %}]){% endif %}
                  |> group(columns: ["service", "node"])
                  |> mean()
                  |> keep(columns: ["service", "node", "_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.rt_crit }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

{% for b in telegraf_buckets %}
      - uid: hl-node-gap-{{ b }}
        title: "Node Telegraf Gap ({{ b }})"
        condition: C
        noDataState: Alerting
        execErrState: Error
        for: "{{ alerts.node_gap_for }}"
        isPaused: false
        annotations:
          summary: "Node {{ b }} has no telegraf data"
          description: "No system.uptime samples in last 5m from bucket {{ b }}. Host or telegraf agent likely down."
        labels:
          severity: critical
          category: node-health
          node: "{{ b }}"
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                from(bucket: "{{ b }}")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "system" and r._field == "uptime")
                  |> count()
                  |> keep(columns: ["_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query
{% endfor %}

