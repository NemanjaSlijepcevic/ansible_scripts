        execErrState: Error
        for: "{{ alerts.cpu_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}High CPU on {{ $labels.node }} ({{ printf \"%.1f\" $values.B.Value }}%){% endraw %}"
          description: "{% raw %}CPU usage above {% endraw %}{{ alerts.cpu_warn }}% for {{ alerts.cpu_for }}"
        labels:
          severity: warning
          category: system
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb }
              query: |
                {% if telegraf_buckets|length > 1 %}union(tables: [{% endif %}
                {% for b in telegraf_buckets %}{% if loop.index > 1 %},{% endif %}
                from(bucket: "{{ b }}")
                  |> range(start: -10m)
                  |> filter(fn: (r) => r._measurement == "cpu" and r.cpu == "cpu-total" and r._field == "usage_idle")
                  |> map(fn: (r) => ({r with node: "{{ b }}", _value: 100.0 - r._value}))
                {% endfor %}
                {% if telegraf_buckets|length > 1 %}]){% endif %}
                  |> group(columns: ["node"])
                  |> mean()
                  |> keep(columns: ["node", "_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
