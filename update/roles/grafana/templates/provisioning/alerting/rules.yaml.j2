      # Safety alarm: any water/leak/smoke/gas binary_sensor in the triggered
      # (=1) state. Multi-dimensional — one alert instance per matching entity.
      - uid: hl-ha-leak
        title: Leak / smoke sensor triggered
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.ha_leak_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.friendly_name }} triggered!{% endraw %}"
          description: "{% raw %}Home Assistant binary sensor {{ $labels.entity }} is in the ON/triggered state (water/leak/smoke/gas).{% endraw %}"
        labels:
          severity: critical
          category: homeassistant
          node: monitor
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 300, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: max by (entity, friendly_name) (hass_binary_sensor_state{entity=~"{{ alerts.ha_leak_regex }}"})
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [0] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      # Any battery-powered sensor below threshold (personal phones excluded).
      - uid: hl-ha-battery-low
        title: Sensor battery low
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.ha_battery_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.friendly_name }} battery {{ printf \"%.0f\" $values.B.Value }}%{% endraw %}"
          description: "{% raw %}Battery below {% endraw %}{{ alerts.ha_battery_warn }}% — replace soon."
        labels:
          severity: warning
          category: homeassistant
          node: monitor
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: min by (entity, friendly_name) (hass_sensor_battery_percent{entity!~"{{ alerts.ha_battery_exclude }}"})
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [{{ alerts.ha_battery_warn }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      # Climate sensor stopped reporting (unavailable) — dead battery/radio
      # dropout. One instance per offline temperature/humidity entity.
      - uid: hl-ha-sensor-offline
        title: Climate sensor offline
        condition: C
        noDataState: OK
