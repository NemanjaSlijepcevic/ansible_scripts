        for: "{{ alerts.ha_offline_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}{{ $labels.friendly_name }} unavailable{% endraw %}"
          description: "{% raw %}HA reports entity {{ $labels.entity }} unavailable for {% endraw %}{{ alerts.ha_offline_for }} — dead battery or radio dropout."
        labels:
          severity: warning
