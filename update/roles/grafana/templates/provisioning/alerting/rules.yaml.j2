            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
