              datasource: { type: prometheus, uid: prometheus }
              expr: 100 - (avg by (host) (rate(node_cpu_seconds_total{mode="idle", host!="pfsense"}[10m])) * 100)
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
