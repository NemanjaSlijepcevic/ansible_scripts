        for: "{{ alerts.pg_gap_for }}"
        isPaused: false
        annotations:
          summary: "Central PostgreSQL has no metrics"
          description: "No postgresql samples in last 5m from bucket telegraf-postgres. Server down, mTLS broken, or telegraf agent unable to connect."
        labels:
          severity: critical
          category: postgres
        data:
          - refId: A
            datasourceUid: influxdb
            relativeTimeRange: { from: 600, to: 0 }
