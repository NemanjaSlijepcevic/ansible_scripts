    rules:

      - uid: hl-pg-gap
        title: PostgreSQL no metrics
        condition: C
        noDataState: Alerting
        execErrState: Error
        for: "{{ alerts.pg_gap_for }}"
        isPaused: false
        annotations:
          summary: "Central PostgreSQL has no metrics"
          description: "pg_up is 0 or absent (host=postgres). Server down, mTLS broken, or the Alloy postgres exporter cannot connect."
        labels:
          severity: critical
          category: postgres
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: max(pg_up{host="postgres"})
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-pg-connections
        title: PostgreSQL connections high
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.pg_conn_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}PostgreSQL backends at {{ printf \"%.0f\" $values.B.Value }}{% endraw %}"
          description: "Total backends above {{ alerts.pg_conn_warn }} — approaching max_connections; a client is likely leaking connections."
        labels:
          severity: warning
          category: postgres
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: sum(pg_stat_database_numbackends{host="postgres"})
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.pg_conn_warn }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-pg-deadlocks
        title: PostgreSQL deadlocks
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.pg_deadlock_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}Deadlocks occurring in database {{ $labels.datname }}{% endraw %}"
          description: "pg_stat_database.deadlocks increased in the last 10m."
        labels:
          severity: warning
          category: postgres
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: sum by (datname) (increase(pg_stat_database_deadlocks{host="postgres"}[10m]))
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [0] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

  - orgId: 1
    name: homelab-containers
    folder: Homelab
    interval: 60s
    rules:

      # Long-lived services run with restart_policy unless-stopped, so a
      # container persisting in "exited" means stopped by hand or Docker gave
      # up. Ephemeral task containers (kestra runners) are removed seconds
      # after exit, so the docker-state textfile gauge goes stale and clears.
      - uid: hl-ct-exited
        title: Container stopped
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.container_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}Container {{ $labels.container_name }} on {{ $labels.host }} is not running{% endraw %}"
          description: "Container has been in state 'exited' for more than ~2 minutes."
        labels:
          severity: critical
          category: containers
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: max by (container_name, host) (docker_container_exited)
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [0] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-ct-oom
        title: Container OOM killed
        condition: C
        noDataState: OK
        execErrState: Error
        for: "0s"
        isPaused: false
        annotations:
          summary: "{% raw %}Container {{ $labels.container_name }} on {{ $labels.host }} was OOM-killed{% endraw %}"
          description: "Docker reported OOMKilled=true — raise the container's memory limit or find the leak."
        labels:
          severity: critical
          category: containers
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: max by (container_name, host) (max_over_time(docker_container_oom_killed[10m]))
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [0] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

  - orgId: 1
    name: homelab-logs
    folder: Homelab
    interval: 60s
    rules:

{% for node in monitored_hosts %}
      # Node-gap rules can't see an Alloy that is running but not shipping
      # logs; absence of ANY log line for a node in 15m means the log pipeline
      # (Alloy → Loki) is broken.
      - uid: hl-log-gap-{{ node }}
        title: "Log ingest gap ({{ node }})"
        condition: C
        noDataState: Alerting
        execErrState: Error
        for: "{{ alerts.log_gap_for }}"
        isPaused: false
        annotations:
          summary: "No logs from {{ node }} reaching Loki"
          description: "Zero log lines with node={{ node }} in the last 15m. Alloy on {{ node }} is down or cannot reach Loki."
        labels:
          severity: critical
          category: logs
          node: "{{ node }}"
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: loki, uid: loki }
              expr: sum(count_over_time({node="{{ node }}"} [15m]))
              queryType: instant
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query
{% endfor %}

  - orgId: 1
    name: homelab-homeassistant
    folder: Homelab
    interval: 60s
    rules:

      # HA down / scrape broken — no hass_* metrics reaching Prometheus. noData
      # is Alerting (the "everything HA is dark" catch); the per-sensor rules
      # below use noData=OK so they don't all fire at once when HA is down.
      - uid: hl-ha-down
        title: Home Assistant metrics gap
        condition: C
        noDataState: Alerting
        execErrState: Error
        for: "{{ alerts.ha_down_for }}"
        isPaused: false
        annotations:
          summary: "Home Assistant is not exporting metrics"
          description: "up{job=homeassistant} is 0 or absent — HA container down, or the Alloy scrape of /api/prometheus is failing (expired token?)."
        labels:
          severity: critical
          category: homeassistant
          node: monitor
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: max(up{job="homeassistant"})
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
