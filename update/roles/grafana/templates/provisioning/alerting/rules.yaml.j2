  - orgId: 1
    name: homelab-security
    folder: Homelab
    interval: 60s
    rules:

      # CrowdSec engine not being scraped (container down) — the Traefik bouncer
      # on that host loses its decision source. Not covered by the blackbox
      # service-down rules (crowdsec :6060 is a metrics scrape, not a probe).
      - uid: hl-crowdsec-down
        title: CrowdSec engine down
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.crowdsec_down_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}CrowdSec on {{ $labels.host }} is not reporting{% endraw %}"
          description: "{% raw %}up{job=\"crowdsec\"} is 0 on {{ $labels.host }} — the CrowdSec container is down; its Traefik bouncer has no live decisions (IDS effectively failing open).{% endraw %}"
        labels:
          severity: critical
          category: security
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: max by (host) (up{job="crowdsec"})
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query
