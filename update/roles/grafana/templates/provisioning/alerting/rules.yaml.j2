                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      # FreeBSD node_exporter has no MemAvailable — used = active + wired
      # (free/inactive/cache are reclaimable). Verify the metric names on
      # rollout; if absent the query yields noData (OK), it will not false-fire.
      - uid: hl-pfsense-mem-high
        title: pfSense High Memory
        condition: C
        noDataState: OK
        execErrState: Error
        for: "{{ alerts.pfsense_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}pfSense memory used {{ printf \"%.1f\" $values.B.Value }}%{% endraw %}"
          description: "{% raw %}pfSense memory above {% endraw %}{{ alerts.pfsense_mem_warn }}% for {{ alerts.pfsense_for }}"
        labels:
          severity: warning
          category: pfsense
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: (node_memory_active_bytes{host="pfsense"} + node_memory_wired_bytes{host="pfsense"}) / node_memory_size_bytes{host="pfsense"} * 100
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [{{ alerts.pfsense_mem_warn }}] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

      - uid: hl-pfsense-wan-down
        title: pfSense WAN no traffic
        condition: C
        noDataState: Alerting
        execErrState: Error
        for: "{{ alerts.wan_down_for }}"
        isPaused: false
        annotations:
          summary: "pfSense WAN ({{ alerts.wan_interface }}) no RX bytes for {{ alerts.wan_down_for }}"
          description: "No incoming traffic on WAN interface — link may be down"
        labels:
          severity: critical
          category: pfsense
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange: { from: 600, to: 0 }
            model:
              refId: A
              datasource: { type: prometheus, uid: prometheus }
              expr: sum(rate(node_network_receive_bytes_total{host="pfsense", device="{{ alerts.wan_interface }}"}[5m]))
              instant: true
              range: false
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: B
              datasource: { type: __expr__, uid: __expr__ }
              type: reduce
              reducer: last
              expression: A
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
            model:
              refId: C
              datasource: { type: __expr__, uid: __expr__ }
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [1] }
                  operator: { type: and }
                  query: { params: [] }
                  reducer: { type: last, params: [] }
                  type: query

