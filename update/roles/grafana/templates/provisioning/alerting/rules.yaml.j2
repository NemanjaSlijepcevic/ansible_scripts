        noDataState: OK
        execErrState: Error
        for: "{{ alerts.proxmox_for }}"
        isPaused: false
        annotations:
          summary: "{% raw %}Proxmox memory used {{ printf \"%.1f\" $values.B.Value }}%{% endraw %}"
          description: "{% raw %}Proxmox memory above {% endraw %}{{ alerts.proxmox_mem_warn }}% for {{ alerts.proxmox_for }}"
        labels:
          severity: warning
          category: proxmox
        data:
          - refId: A
            datasourceUid: influxdb-proxmox
            relativeTimeRange: { from: 900, to: 0 }
            model:
              refId: A
              datasource: { type: influxdb, uid: influxdb-proxmox }
              query: |
                from(bucket: "proxmox")
                  |> range(start: -10m)
                  |> filter(fn: (r) => r._measurement == "memory" and (r._field == "used" or r._field == "total"))
                  |> last()
                  |> pivot(rowKey: ["host"], columnKey: ["_field"], valueColumn: "_value")
                  |> map(fn: (r) => ({_value: 100.0 * r.used / r.total}))
                  |> keep(columns: ["_value"])
          - refId: B
            datasourceUid: __expr__
