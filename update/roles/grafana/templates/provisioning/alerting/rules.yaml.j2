              datasource: { type: influxdb, uid: influxdb }
              query: |
                from(bucket: "telegraf-postgres")
                  |> range(start: -5m)
                  |> filter(fn: (r) => r._measurement == "postgresql" and r._field == "numbackends")
                  |> count()
                  |> group()
                  |> sum()
                  |> keep(columns: ["_value"])
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: { from: 0, to: 0 }
