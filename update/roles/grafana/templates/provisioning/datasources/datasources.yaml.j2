apiVersion: 1

# Remove the retired InfluxDB datasources (file provisioning only removes
# file-provisioned entries; the one the old influxdb role registered via the
# HTTP API must be deleted by hand once — see the postgres/alloy migration doc).
deleteDatasources:
  - name: InfluxDB
    orgId: 1
  - name: InfluxDB-Proxmox
    orgId: 1
  - name: InfluxDB-pfSense
    orgId: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
      timeInterval: "15s"

  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: http://loki:3100
    editable: false
    jsonData:
      maxLines: 1000
