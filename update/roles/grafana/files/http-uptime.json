  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__PROMETHEUS_UID__"
        },
        "definition": "label_values(probe_success, host)",
        "query": {
          "query": "label_values(probe_success, host)",
          "refId": "host"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "regex": "",
        "sort": 1,
        "options": [],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        }
      },
      {
        "name": "via",
        "label": "Via",
        "type": "custom",
        "query": "internal,domain",
        "current": {
          "text": "internal",
          "value": "internal"
        },
        "options": [
          {
            "text": "internal",
            "value": "internal",
            "selected": true
          },
          {
            "text": "domain",
            "value": "domain",
            "selected": false
