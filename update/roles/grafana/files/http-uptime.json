{
  "uid": "homelab-http-uptime",
  "title": "Homelab — HTTP Uptime (Kuma-like)",
  "tags": [
    "homelab",
    "uptime",
    "blackbox"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
