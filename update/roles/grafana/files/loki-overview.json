{
  "uid": "homelab-loki-overview",
  "title": "Homelab — Loki Logs Overview",
  "tags": ["homelab", "loki", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "style": "dark",
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
        "definition": "label_values(node)",
        "query": { "label": "node", "stream": "", "type": 1, "refId": "LokiVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "regex": "",
        "sort": 1,
        "options": [],
        "current": { "text": ["All"], "value": ["$__all"], "selected": true }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
        "definition": "label_values({node=~\"$node\"}, container)",
        "query": { "label": "container", "stream": "{node=~\"$node\"}", "type": 1, "refId": "LokiVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "regex": "",
        "sort": 1,
        "options": [],
        "current": { "text": ["All"], "value": ["$__all"], "selected": true }
      },
      {
        "name": "logstream",
        "label": "Stream",
        "type": "custom",
        "query": "All : .+, stdout : stdout, stderr : stderr",
        "current": { "text": "All", "value": ".+", "selected": true },
        "options": [
          { "text": "All",    "value": ".+",    "selected": true },
          { "text": "stdout", "value": "stdout", "selected": false },
          { "text": "stderr", "value": "stderr", "selected": false }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "level_regex",
        "label": "Error pattern",
        "type": "textbox",
        "query": "(?i)(error|err|fail|exception|panic|fatal|critical|warn)",
        "current": { "text": "(?i)(error|err|fail|exception|panic|fatal|critical|warn)", "value": "(?i)(error|err|fail|exception|panic|fatal|critical|warn)" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Log lines/sec (1m)",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "sum(rate({node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"}[1m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 200 }
          ]},
          "unit": "logs/sec",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error lines/sec (1m)",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "sum(rate({node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"} != \"query_hash\" |~ \"$level_regex\" [1m]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]},
          "unit": "logs/sec",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active containers (1h)",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "count(sum by(container)(count_over_time({node=~\"$node\", container=~\"$container\"}[1h])))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total lines (selected range)",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "sum(count_over_time({node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null }
          ]},
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Trends",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Log rate by container",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "sum by(container) (rate({node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"}[$__interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "logs/sec"
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Error rate by container",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "sum by(container) (rate({node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"} != \"query_hash\" |~ \"$level_regex\" [$__interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" },
          "unit": "logs/sec"
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Top Producers",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Top 10 noisy containers (selected range)",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "topk(10, sum by(container) (count_over_time({node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"}[$__range])))",
          "legendFormat": "{{container}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }
      }
    },
    {
      "id": 22,
      "type": "table",
      "title": "Top 10 error producers (selected range)",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "topk(10, sum by(container) (count_over_time({node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"} != \"query_hash\" |~ \"$level_regex\" [$__range])))",
          "legendFormat": "{{container}}",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "Value": "Errors", "container": "Container" },
            "indexByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Errors", "desc": true }] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 100 }
          ]},
          "custom": { "align": "auto", "displayMode": "color-background-solid" },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Errors" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } }] }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Live Tail",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "panels": []
    },
    {
      "id": 31,
      "type": "logs",
      "title": "Logs (filtered)",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "{node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Errors Drill-down",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "panels": [
        {
          "id": 41,
          "type": "logs",
          "title": "Error logs only",
          "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "gridPos": { "h": 16, "w": 24, "x": 0, "y": 42 },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
              "expr": "{node=~\"$node\", container=~\"$container\", logstream=~\"$logstream\"} != \"query_hash\" |~ \"$level_regex\""
            }
          ],
          "options": {
            "showTime": true,
            "showLabels": true,
            "showCommonLabels": false,
            "wrapLogMessage": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "sortOrder": "Descending",
            "dedupStrategy": "none"
          }
        }
      ]
    }
  ]
}
