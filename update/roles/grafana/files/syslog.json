          "expr": "sum(rate({job=\"syslog\", device=~\"$device\", severity=~\"warning|warn|error|err|critical|crit|alert|emergency|emerg\"}[1m]))", "queryType": "instant" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
