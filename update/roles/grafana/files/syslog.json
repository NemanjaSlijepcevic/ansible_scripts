      "title": "Firewall pass vs block /sec",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "sum(rate({job=\"syslog\", device=\"pfsense\", app=\"filterlog\"} |~ \",block,\" [$__interval]))", "legendFormat": "block" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "sum(rate({job=\"syslog\", device=\"pfsense\", app=\"filterlog\"} |~ \",pass,\" [$__interval]))", "legendFormat": "pass" }
