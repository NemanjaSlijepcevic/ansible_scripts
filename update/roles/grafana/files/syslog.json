        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
        "definition": "label_values({job=\"syslog\"}, device)",
        "query": { "label": "device", "stream": "{job=\"syslog\"}", "type": 1, "refId": "LokiVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "regex": "",
        "sort": 1,
        "options": [],
        "current": { "text": ["All"], "value": ["$__all"], "selected": true }
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "query",
        "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
        "definition": "label_values({job=\"syslog\", device=~\"$device\"}, severity)",
        "query": { "label": "severity", "stream": "{job=\"syslog\", device=~\"$device\"}", "type": 1, "refId": "LokiVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "regex": "",
        "sort": 1,
        "options": [],
        "current": { "text": ["All"], "value": ["$__all"], "selected": true }
      },
      {
        "name": "app",
        "label": "pfSense app",
        "type": "query",
        "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
        "definition": "label_values({job=\"syslog\", device=\"pfsense\"}, app)",
        "query": { "label": "app", "stream": "{job=\"syslog\", device=\"pfsense\"}", "type": 1, "refId": "LokiVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "hide": 0,
        "regex": "",
        "sort": 1,
        "options": [],
        "current": { "text": ["All"], "value": ["$__all"], "selected": true }
      },
      {
        "name": "search",
        "label": "Line filter (regex)",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total lines/sec (1m)",
      "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "__LOKI_UID__" },
          "expr": "sum(rate({job=\"syslog\", device=~\"$device\"}[1m]))", "queryType": "instant" }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 200 }
          ]},
          "unit": "logs/sec", "decimals": 2
        },
        "overrides": []
      }
    },
    {
