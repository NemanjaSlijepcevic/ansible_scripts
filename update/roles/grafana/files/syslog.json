{
  "uid": "homelab-syslog",
  "title": "Homelab — Syslog (pfSense & AP)",
  "tags": ["homelab", "loki", "syslog", "pfsense", "ap"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
