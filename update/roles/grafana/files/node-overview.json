        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "count(count by (cpu) (node_cpu_seconds_total{host=~\"$host\"}))",
          "legendFormat": "n_cpus"
