            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "node_load1{host=~\"$host\"}",
          "legendFormat": "load1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
