        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "topk(12, sum by (friendly_name) (rate(hass_state_change_total{host=~\"$host\"}[$__rate_interval])) * 60)",
