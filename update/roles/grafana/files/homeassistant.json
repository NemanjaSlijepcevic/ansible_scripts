    {
      "id": 13,
      "type": "timeseries",
      "title": "Most active entities (changes/min)",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
