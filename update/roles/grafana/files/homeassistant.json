      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "hass_entity_available{host=~\"$host\"} == 0",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "host": true,
              "Value": true
            },
            "renameByName": {
              "friendly_name": "entity",
              "domain": "type"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "entity",
            "desc": false
          }
        ]
      }
