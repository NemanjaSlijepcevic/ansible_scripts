
# Loads default set of integrations. Do not remove.
default_config:

# HIDDEN: no Bluetooth hardware is passed into this container, so HA's
# bluetooth auto-recovery loops and spams WARNINGs every ~20s. Suppress just
# those two loggers (rest of HA logging unchanged). Remove this block when
# Bluetooth is actually available so the warnings surface again.
logger:
  logs:
    bluetooth_auto_recovery: error
    homeassistant.components.bluetooth: error

# Load frontend themes from the themes folder
# frontend:
#   themes: !include_dir_merge_named themes

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

http:
  use_x_forwarded_for: true
  trusted_proxies:
    - {{ docker.subnet }}

telegram_bot:
  - platform: polling
    api_key: "{{ homeassistant.telegram.api_key }}"
    allowed_chat_ids:
      - {{ homeassistant.telegram.chat_id }}

notify:
  - platform: telegram
    name: HomeAssistant
    chat_id: {{ homeassistant.telegram.chat_id }}

# Expose /api/prometheus so the Alloy agent on this host can scrape HA's entity
# metrics and remote-write them to Prometheus. The endpoint requires auth:
# Alloy sends homeassistant.prometheus_token.
prometheus:
  namespace: hass
