# Managed by Ansible (kestra role, templates/flows/) — UI edits to this
# flow id are overwritten on the next playbook run.
# NOTE: square-bracket delimiters are Ansible/Jinja (rendered at deploy
# time); curly-brace expressions are Kestra's own and reach the server
# untouched.
id: kestra-failure-triage
namespace: automation
description: Claude-triage any failed Kestra execution and post the diagnosis to Telegram.

triggers:
  - id: on_failed_execution
    type: io.kestra.plugin.core.trigger.Flow
    conditions:
      - type: io.kestra.plugin.core.condition.ExecutionStatus
        in:
          - FAILED
      - type: io.kestra.plugin.core.condition.ExecutionNamespace
        namespace: automation
        prefix: false

tasks:
  # Loop guard: never triage our own failures or the claude-telegram
  # worker's — either would retrigger this flow indefinitely while e.g.
  # the Anthropic API is unreachable.
  - id: not_self
    type: io.kestra.plugin.core.flow.If
    condition: "{{ trigger.flowId != flow.id and trigger.flowId != 'claude-telegram' }}"
    then:
      - id: triage
        type: io.kestra.plugin.core.flow.Subflow
        namespace: automation
        flowId: claude-telegram
        wait: true
        transmitFailed: true
        inputs:
          prompt: |
            You are the on-call assistant for a self-hosted homelab automation host running Kestra. The infrastructure repo is mounted read-only at /repo; the source of every Kestra flow is in /repo/update/roles/kestra/templates/flows/ and the runner images are described in /repo/docs/update/kestra.md.
            A Kestra execution just FAILED:
            - flow: {{ trigger.namespace }}/{{ trigger.flowId }}
            - execution id: {{ trigger.executionId }}
            - final state: {{ trigger.state }}
            Read that flow's source, explain the most likely causes of the failure, and give concrete next steps (what to check in the execution log, which containers/hosts to inspect, exact commands).
            Reply as plain text suitable for a Telegram message: no markdown, at most 40 short lines.
