# Managed by Ansible (kestra role, templates/flows/) — UI edits to this
# flow id are overwritten on the next playbook run.
# NOTE: square-bracket delimiters are Ansible/Jinja (rendered at deploy
# time); curly-brace expressions are Kestra's own and reach the server
# untouched.
#
# Fed by the "Kestra" webhook contact point provisioned in the grafana
# role (fan-out route: Telegram gets the raw alert immediately, this flow
# adds a Claude diagnosis as a follow-up Telegram message).
id: grafana-alert-triage
namespace: automation
description: Claude-triage firing Grafana alerts and post the diagnosis to Telegram.

triggers:
  - id: grafana_webhook
    type: io.kestra.plugin.core.trigger.Webhook
    key: "[[ kestra.grafana_webhook_key ]]"

tasks:
  # Only triage firing notifications — resolutions need no diagnosis.
  - id: firing_only
    type: io.kestra.plugin.core.flow.If
    condition: "{{ trigger.body.status == 'firing' }}"
    then:
      - id: triage
        type: io.kestra.plugin.core.flow.Subflow
        namespace: automation
        flowId: claude-telegram
        wait: true
        transmitFailed: true
        inputs:
          prompt: |
            You are the on-call assistant for a self-hosted homelab (Ansible-managed Docker services behind Traefik/Authelia/CrowdSec, central PostgreSQL, Prometheus/Loki monitoring). The infrastructure repo is mounted read-only at /repo — read /repo/CLAUDE.md and the relevant /repo/docs pages before answering.
            A Grafana alert is FIRING. Diagnose the most likely cause and give concrete next steps: which host to look at, exact commands to run, what to check first. Be specific to this infrastructure, not generic advice.
            Reply as plain text suitable for a Telegram message: no markdown, at most 40 short lines.
            Alert payload:
            {{ trigger.body | toJson }}
