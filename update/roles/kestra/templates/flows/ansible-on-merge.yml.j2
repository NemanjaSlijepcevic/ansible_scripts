# Managed by Ansible (kestra role, templates/flows/) — UI edits to this
# flow id are overwritten on the next playbook run.
# NOTE: square-bracket delimiters are Ansible/Jinja (rendered at deploy
# time); curly-brace expressions are Kestra's own and reach the server
# untouched.
#
# Wire-up on GitHub (manual, one-time): repo → Settings → Webhooks →
# Add webhook:
#   Payload URL:  https://<kestra-domain>/api/v1/main/executions/webhook/automation/ansible-on-merge/<github_webhook_key>
#   Content type: application/json
#   Events:       just the push event
# A merged PR lands as a push to main, so the ref check below covers both
# direct pushes and merges. Requires the kestra domain to be reachable
# from GitHub (public exposure via pfSense/HAProxy + Cloudflare).
id: ansible-on-merge
namespace: automation
description: Run the full infrastructure update when this repo's main branch receives a push/merge.

triggers:
  - id: github_push
    type: io.kestra.plugin.core.trigger.Webhook
    key: "[[ kestra.github_webhook_key ]]"

tasks:
  # GitHub sends pushes for every branch the hook covers — act on main
  # only. The actual playbook loop (repo sync, sequential run, per-host
  # allowFailure, failure mail) lives in ansible-update-all; reuse it so
  # there is exactly one place defining what "update everything" means.
  - id: main_only
    type: io.kestra.plugin.core.flow.If
    condition: "{{ trigger.body.ref == 'refs/heads/main' }}"
    then:
      - id: run_updates
        type: io.kestra.plugin.core.flow.Subflow
        namespace: automation
        flowId: ansible-update-all
        wait: true
        transmitFailed: true
        inputs:
          check_mode: false
