access_control:
  default_policy: deny
  rules:
    - domain:
        - "{{ authelia_links.domain }}"
      policy: bypass
    # Kestra webhook triggers are called by external systems and must not
    # hit forward-auth (Kestra's own basic auth also open-urls this path).
    - domain:
        - "{{ kestra.domain }}"
      resources:
        - "^/api/v1/main/executions/webhook/.*"
        - "^/api/v1/executions/webhook/.*"
      policy: bypass
    - domain:
        - "{{ kestra.domain }}"
        - "{{ traefik_links.name.link }}"
      policy: two_factor

session:
  cookies:
  - domain: "{{ default.domain }}"
    authelia_url: "{{ authelia_links.url }}"

{% include 'storage_tls.yml.j2' %}
