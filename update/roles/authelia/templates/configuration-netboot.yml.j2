access_control:
  default_policy: deny
  rules:
    - domain:
        - "{{ authelia_links.domain }}"
      policy: bypass
    - domain:
        - "{{ netboot.domain }}"
        - "{{ netboot.assets_domain }}"
        - "{{ traefik_links.name.link }}"
      policy: two_factor

session:
  cookies:
  - domain: "{{ default.domain }}"
    authelia_url: "{{ authelia_links.url }}"

{% include 'storage_tls.yml.j2' %}
