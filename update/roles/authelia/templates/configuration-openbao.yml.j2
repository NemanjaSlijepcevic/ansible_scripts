access_control:
  default_policy: deny
  rules:
    - domain:
        - "{{ authelia_links.domain }}"
        - "{{ openbao.domain }}"
      policy: bypass
    # OpenBao carries its own auth + UI, so its router uses chain-no-auth and
    # never reaches Authelia's forward-auth. The Traefik dashboard link stays
    # protected here.
    - domain:
        - "{{ traefik_links.name.link }}"
      policy: two_factor

session:
  cookies:
  - domain: "{{ default.domain }}"
    authelia_url: "{{ authelia_links.url }}"

{% include 'storage_tls.yml.j2' %}
