
identity_providers:
  oidc:
    jwks:
      - key_id: main
        algorithm: RS256
        use: sig
        key: |
{{ authelia_oidc_jwk_content.content | b64decode | indent(10, first=True) }}
    cors:
      endpoints:
        - token
        - introspection
{% if grafana is defined %}
    claims_policies:
      grafana:
        id_token: ['email', 'name', 'groups', 'preferred_username']
{% endif %}
    clients:
{% if immich is defined %}
      - client_id: "{{ authelia.oidc.immich.client_id }}"
        client_name: Immich
        client_secret: "{{ authelia.oidc.immich.client_secret_hash }}"
        public: false
        authorization_policy: two_factor
        require_pkce: false
        redirect_uris:
          - "{{ immich.url }}/auth/login"
          - "{{ immich.url }}/user-settings"
          - "app.immich:///oauth-callback"
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_post
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
{% endif %}
{% if seerr is defined %}
      - client_id: "{{ authelia.oidc.seerr.client_id }}"
        client_name: Seerr
        client_secret: "{{ authelia.oidc.seerr.client_secret_hash }}"
        public: false
        authorization_policy: two_factor
        require_pkce: false
        redirect_uris:
          - "{{ seerr.url }}/login?provider=authelia&callback=true"
        scopes:
          - openid
          - email
          - profile
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_post
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
{% endif %}
{% if grafana is defined %}
      - client_id: "{{ authelia.oidc.grafana.client_id }}"
        client_name: Grafana
        client_secret: "{{ authelia.oidc.grafana.client_secret_hash }}"
        public: false
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris:
          - "{{ grafana.url }}/login/generic_oauth"
        scopes:
          - openid
          - profile
          - groups
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_basic
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
        claims_policy: grafana
{% endif %}

{% if jellyfin is defined %}
      - client_id: "{{ authelia.oidc.jellyfin.client_id }}"
        client_name: Jellyfin
        client_secret: "{{ authelia.oidc.jellyfin.client_secret_hash }}"
        public: false
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris:
          - "{{ jellyfin.url }}/sso/OID/redirect/authelia"
        scopes:
          - openid
          - profile
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_post
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
{% endif %}
{% if pgadmin is defined %}
      - client_id: "{{ authelia.oidc.pgadmin.client_id }}"
        client_name: pgAdmin
        client_secret: "{{ authelia.oidc.pgadmin.client_secret_hash }}"
        public: false
        authorization_policy: two_factor
        redirect_uris:
          - "{{ pgadmin.url }}/oauth2/authorize"
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        token_endpoint_auth_method: client_secret_basic
        pkce_challenge_method: S256
        userinfo_signed_response_alg: none
{% endif %}
