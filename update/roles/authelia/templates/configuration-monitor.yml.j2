access_control:
  default_policy: deny
  rules:
    - domain:
      - "{{ authelia_links.domain }}"
      - "{{ grafana.domain }}"
      - "{{ homeassistant.domain }}"
      - "{{ prometheus.domain }}"
      - "{{ loki.domain }}"
      - "{{ mqtt.domain }}"
      - "{{ node.ip.domain }}"
      policy: bypass
    - domain: "{{ traefik_links.name.link }}"
      policy: two_factor

{% include 'identity_providers.yml.j2' %}

session:
  cookies:
  - domain: "{{ default.domain }}"
    authelia_url: "{{ authelia_links.url }}"

{% include 'storage_tls.yml.j2' %}
