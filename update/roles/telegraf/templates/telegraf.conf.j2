[global_tags]
  host = "{{ current_host }}"

[agent]
  # On fuse-overlayfs hosts every gather's file churn is amplified through
  # FUSE (lookup per path component x per image layer); a longer interval
  # cuts that CPU tax proportionally.
  interval = "{{ telegraf_agent_interval | default('10s') }}"
  flush_interval = "{{ telegraf_agent_interval | default('10s') }}"

[[outputs.influxdb_v2]]
  urls = ["{{ influxdb.url }}"]
  token = "{{ influxdb.api_token }}"
  organization = "{{ influxdb.organization }}"
  bucket = "telegraf-{{ current_host }}"

[[inputs.prometheus]]
  urls = ["http://crowdsec:6060/metrics"]
  metric_version = 2

[[inputs.prometheus]]
  urls = ["http://{{ docker.gateway }}:9323/metrics"]
  metric_version = 2
  [inputs.prometheus.tags]
    source = "docker_daemon"


{% if current_host == 'postgres' %}
[[inputs.postgresql]]
  address = "host=postgres port={{ postgres.port }} user={{ postgres.adm_user }} password={{ postgres.adm_pass }} sslmode=verify-ca sslrootcert=/postgres-certs/ca.crt sslcert=/postgres-certs/postgres_admin.crt sslkey=/postgres-certs/postgres_admin.key dbname=postgres"

{% endif %}
[[inputs.docker]]
  endpoint = "unix:///var/run/docker.sock"
  gather_services = false
  timeout = "5s"
  container_state_include = ["running", "exited"]

[[inputs.exec]]
  commands = ["/etc/telegraf/scripts/docker-images.sh"]
  # 30s (was 10s): 3 bounded curls (images/dangling/system-df) can sum past
  # 10s under load even with the script's per-curl --max-time 4.
  timeout = "30s"
  data_format = "influx"
  interval = "60s"

{% if telegraf.http_checks is defined %}
{% for check in telegraf.http_checks %}
[[inputs.http_response]]
  urls = ["{{ check.internal_url }}"]
  response_timeout = "5s"
  method = "GET"
  [inputs.http_response.tags]
    service = "{{ check.name }}"
    via = "internal"

[[inputs.http_response]]
  urls = ["{{ check.url }}"]
  response_timeout = "5s"
  method = "GET"
  [inputs.http_response.tags]
    service = "{{ check.name }}"
    via = "domain"

{% endfor %}
{% endif %}

[[inputs.cpu]]
  percpu = true
  totalcpu = true
  collect_cpu_time = false
  report_active = false

[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "iso9660", "overlay", "aufs", "squashfs"]

{% if telegraf_diskio_enabled | default(true) %}
[[inputs.diskio]]
  skip_serial_number = true
{% if telegraf_diskio_devices is defined and telegraf_diskio_devices | length > 0 %}
  # restrict to the guest's real block devices; without this, an LXC guest
  # enumerates the Proxmox host's disks (visible in /proc/diskstats) and
  # warns "Unable to gather disk name" for every one (no matching /dev node).
  devices = {{ telegraf_diskio_devices | to_json }}
{% endif %}
{% endif %}

[[inputs.kernel]]

[[inputs.mem]]

[[inputs.net]]

[[inputs.netstat]]

[[inputs.processes]]

[[inputs.swap]]

[[inputs.system]]
